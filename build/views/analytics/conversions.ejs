<%- include('../partials/dashboard_head', { title: 'Conversions' }) %>
<%- include('../partials/dashboard_nav', { activeTab, range, rangeQuery, exportReport, currentPath }) %>

<main class="grid gap-4 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-4 lg:col-span-2">
    <h2 class="text-base font-semibold">Conversion Totals</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <article class="rounded-lg border border-slate-800 bg-slate-950/60 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-400">Resume Downloads</p>
        <p class="mt-1 text-2xl font-semibold"><%= conversions.counts.click_resume_download %></p>
      </article>
      <article class="rounded-lg border border-slate-800 bg-slate-950/60 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-400">Contact Clicks</p>
        <p class="mt-1 text-2xl font-semibold"><%= conversions.counts.click_contact %></p>
      </article>
      <article class="rounded-lg border border-slate-800 bg-slate-950/60 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-400">Form Submits</p>
        <p class="mt-1 text-2xl font-semibold"><%= conversions.counts.submit_contact_form %></p>
      </article>
    </div>
  </section>

  <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-4">
    <h2 class="text-base font-semibold">Funnel: Home → Case Study → Contact</h2>
    <div class="mt-2 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left text-slate-400">
          <tr>
            <th class="py-1 pr-4">Step</th>
            <th class="py-1 pr-4">Sessions</th>
            <th class="py-1">Step Conversion</th>
          </tr>
        </thead>
        <tbody>
          <% conversions.funnel.homeToCaseToContact.forEach((row, index) => {
            const prev = index === 0 ? row.sessions : conversions.funnel.homeToCaseToContact[index - 1].sessions;
            const rate = prev > 0 ? (row.sessions / prev) * 100 : 0;
          %>
            <tr class="border-t border-slate-800">
              <td class="py-2 pr-4"><%= row.step %></td>
              <td class="py-2 pr-4"><%= row.sessions %></td>
              <td class="py-2"><%= index === 0 ? '-' : `${rate.toFixed(1)}%` %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-4">
    <h2 class="text-base font-semibold">Funnel: Case Study → Resume</h2>
    <div class="mt-2 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left text-slate-400">
          <tr>
            <th class="py-1 pr-4">Step</th>
            <th class="py-1 pr-4">Sessions</th>
            <th class="py-1">Step Conversion</th>
          </tr>
        </thead>
        <tbody>
          <% conversions.funnel.caseToResume.forEach((row, index) => {
            const prev = index === 0 ? row.sessions : conversions.funnel.caseToResume[index - 1].sessions;
            const rate = prev > 0 ? (row.sessions / prev) * 100 : 0;
          %>
            <tr class="border-t border-slate-800">
              <td class="py-2 pr-4"><%= row.step %></td>
              <td class="py-2 pr-4"><%= row.sessions %></td>
              <td class="py-2"><%= index === 0 ? '-' : `${rate.toFixed(1)}%` %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('../partials/dashboard_footer') %>
