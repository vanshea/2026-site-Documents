<!DOCTYPE html>
<html lang="en" data-theme="theme2">
  <head>
    <%- include("../partials/public_head", {
      pageTitle,
      metaDescription,
      extraStyles: ["/assets/aidesign.css?v=20260709-self-care-responsive-1"]
    }) %>
  </head>
  <body>
    <div class="bg-shape bg-shape-a"></div>
    <div class="bg-shape bg-shape-b"></div>

    <%- include("../partials/public_header", { currentPath }) %>

    <main id="top" class="aide-sample-main">
      <h1><%= landing.intro %></h1>
      <h3><%= landing.introDetail %></h3>
      <h2><%= landing.standaloneIdea.title %></h2>
      <p class="aide-sample-description"><%= landing.standaloneIdea.description %></p>
      <iframe
        class="aide-sample-frame"
        src="<%= landing.standaloneIdea.href %>"
        title="<%= landing.standaloneIdea.title %>"
        loading="eager"
      ></iframe>
      <button
        class="aide-sample-preview"
        type="button"
        aria-haspopup="dialog"
        aria-controls="selfCarePrototypeOverlay"
        data-aide-prototype-open
        data-prototype-src="<%= landing.standaloneIdea.href %>"
        data-prototype-title="<%= landing.standaloneIdea.title %>"
      >
        <img
          src="/assets/aidesign/self-care-thumbnail.svg"
          alt=""
          width="360"
          height="678"
          loading="eager"
        />
        <span class="sr-only">Open <%= landing.standaloneIdea.title %></span>
      </button>
    </main>

    <div
      class="aide-prototype-overlay"
      id="selfCarePrototypeOverlay"
      role="dialog"
      aria-modal="true"
      aria-label="<%= landing.standaloneIdea.title %>"
      hidden
      data-aide-prototype-overlay
    >
      <button class="aide-prototype-close" type="button" aria-label="Close prototype" data-aide-prototype-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <iframe
        class="aide-prototype-frame"
        title="<%= landing.standaloneIdea.title %>"
        loading="lazy"
        data-aide-prototype-frame
      ></iframe>
    </div>

    <%- include("../partials/public_footer") %>
    <%- include("../partials/consent_banner") %>

    <script src="/analytics.js"></script>
    <script src="/script.js"></script>
    <script src="/assets/aidesign.js"></script>
  </body>
</html>
