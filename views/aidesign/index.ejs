<!DOCTYPE html>
<html lang="en" data-theme="theme2">
  <head>
    <%- include("../partials/public_head", {
      pageTitle,
      metaDescription,
      extraStyles: ["/assets/aidesign.css?v=20260710-idea-sidebar-1"]
    }) %>
  </head>
  <body>
    <div class="bg-shape bg-shape-a"></div>
    <div class="bg-shape bg-shape-b"></div>

    <%- include("../partials/public_header", { currentPath }) %>

    <main id="top" class="aide-sample-main">
      <header class="aide-sample-intro">
        <h1><%= landing.intro %></h1>
        <h3><%= landing.introDetail %></h3>
      </header>

      <div class="aide-idea-browser" data-aide-idea-browser>
        <aside class="aide-idea-sidebar" aria-label="AI Design Lab ideas">
          <p class="aide-idea-sidebar-label">Ideas</p>
          <div class="aide-idea-list" role="tablist" aria-label="Choose an idea">
            <% landing.standaloneIdeas.forEach((idea, index) => { %>
              <button
                class="aide-idea-tab<%= index === 0 ? ' is-active' : '' %>"
                id="idea-tab-<%= idea.slug %>"
                type="button"
                role="tab"
                aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                aria-controls="idea-panel-<%= idea.slug %>"
                tabindex="<%= index === 0 ? '0' : '-1' %>"
                data-aide-idea-tab="<%= idea.slug %>"
              >
                <span class="aide-idea-index"><%= String(index + 1).padStart(2, '0') %></span>
                <span class="aide-idea-name"><%= idea.title %></span>
                <span class="aide-idea-arrow" aria-hidden="true">→</span>
              </button>
            <% }) %>
          </div>
        </aside>

        <div class="aide-idea-workbench">
          <% landing.standaloneIdeas.forEach((idea, index) => { %>
            <section
              class="aide-sample-project"
              id="idea-panel-<%= idea.slug %>"
              role="tabpanel"
              aria-labelledby="idea-tab-<%= idea.slug %>"
              data-aide-idea-panel="<%= idea.slug %>"
              <%= index === 0 ? '' : 'hidden' %>
            >
              <p class="aide-idea-meta"><%= idea.meta %></p>
              <h2><%= idea.title %></h2>
              <p class="aide-sample-description"><%= idea.description %></p>
              <iframe
                class="aide-sample-frame"
                <% if (index === 0) { %>src="<%= idea.href %>"<% } else { %>data-src="<%= idea.href %>"<% } %>
                title="<%= idea.title %>"
                loading="<%= index === 0 ? 'eager' : 'lazy' %>"
              ></iframe>
              <button
                class="aide-sample-preview"
                type="button"
                aria-haspopup="dialog"
                aria-controls="aidePrototypeOverlay"
                data-aide-prototype-open
                data-prototype-src="<%= idea.href %>"
                data-prototype-title="<%= idea.title %>"
              >
                <img
                  src="<%= idea.thumbnail %>"
                  alt=""
                  width="<%= idea.thumbnailWidth %>"
                  height="<%= idea.thumbnailHeight %>"
                  loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                />
                <span class="sr-only">Open <%= idea.title %></span>
              </button>
            </section>
          <% }) %>
        </div>
      </div>
    </main>

    <div
      class="aide-prototype-overlay"
      id="aidePrototypeOverlay"
      role="dialog"
      aria-modal="true"
      aria-label="Interactive AI Design Lab prototype"
      hidden
      data-aide-prototype-overlay
    >
      <button class="aide-prototype-close" type="button" aria-label="Close prototype" data-aide-prototype-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <iframe
        class="aide-prototype-frame"
        title="Interactive AI Design Lab prototype"
        loading="lazy"
        data-aide-prototype-frame
      ></iframe>
    </div>

    <%- include("../partials/public_footer") %>
    <%- include("../partials/consent_banner") %>

    <script src="/analytics.js"></script>
    <script src="/script.js"></script>
    <script src="/assets/aidesign.js"></script>
  </body>
</html>
