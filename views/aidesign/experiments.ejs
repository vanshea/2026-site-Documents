<!DOCTYPE html>
<html lang="en" data-theme="theme2">
  <head>
    <%- include("../partials/public_head", {
      pageTitle,
      metaDescription,
      extraStyles: ["/assets/aidesign.css"]
    }) %>
  </head>
  <body>
    <div class="bg-shape bg-shape-a"></div>
    <div class="bg-shape bg-shape-b"></div>

    <%- include("../partials/public_header", { currentPath }) %>

    <main id="top" class="aide-main">
      <nav class="aide-breadcrumb" aria-label="AI Design Lab breadcrumb">
        <a href="/aidesign">AI Design Lab</a>
        <span aria-hidden="true">/</span>
        <span>Experiments</span>
      </nav>

      <section class="aide-hero aide-compact-hero reveal">
        <div class="aide-hero-copy">
          <p class="eyebrow">Experiment Index</p>
          <h1>AI Application Experiments</h1>
          <p class="lead">
            Small prototypes comparing how AI platforms interpret prompts, make interface
            decisions, handle uncertainty, and support human judgment.
          </p>
        </div>
      </section>

      <section class="aide-section reveal" aria-labelledby="experimentListHeading">
        <div class="section-head aide-section-head">
          <div>
            <p class="eyebrow">Current tests</p>
            <h2 id="experimentListHeading">Published Experiments</h2>
          </div>
        </div>

        <div class="aide-card-grid">
          <article class="aide-experiment-card">
  <a class="aide-experiment-card-link" href="<%= landing.standaloneIdea.href %>">
    <span class="aide-card-visual aide-self-care-card-visual" aria-hidden="true">
      <span class="aide-self-care-card-phone">
        <span class="aide-self-care-card-pill"></span>
        <span class="aide-self-care-card-widget">
          <span>SC</span>
          <i></i>
        </span>
        <span class="aide-self-care-card-row"></span>
        <span class="aide-self-care-card-row aide-self-care-card-row-short"></span>
      </span>
    </span>
    <span class="aide-card-meta"><%= landing.standaloneIdea.meta %></span>
    <h3><%= landing.standaloneIdea.title %></h3>
    <p><%= landing.standaloneIdea.shortDescription %></p>
    <span class="aide-card-action">Launch Standalone Prototype</span>
  </a>
</article>

          <% experiments.forEach((experiment) => { %>
            <%- include("../partials/aidesign/experiment-card", { experiment }) %>
          <% }) %>
        </div>
      </section>

      <section class="aide-section aide-two-column reveal" aria-labelledby="howToReadHeading">
        <div>
          <p class="eyebrow">How to read these</p>
          <h2 id="howToReadHeading">A prototype is only part of the answer.</h2>
        </div>
        <div class="aide-section-copy">
          <p>
            Each result is reviewed as both design and software: what the tool notices, what it
            ignores, how it explains uncertainty, and whether the interface supports better
            decisions.
          </p>
          <p>
            The key question is not only whether the code works, but whether the product thinking
            deserves trust.
          </p>
        </div>
      </section>
    </main>

    <%- include("../partials/public_footer") %>
    <%- include("../partials/consent_banner") %>

    <script src="/analytics.js"></script>
    <script src="/script.js"></script>
  </body>
</html>
