<!DOCTYPE html>
<html lang="en" data-theme="theme2">
  <head>
    <%- include("../partials/public_head", {
      pageTitle,
      metaDescription,
      extraStyles: ["/assets/aidesign.css"]
    }) %>
  </head>
  <body>
    <div class="bg-shape bg-shape-a"></div>
    <div class="bg-shape bg-shape-b"></div>

    <%- include("../partials/public_header", { currentPath }) %>

    <main id="top" class="aide-main aide-experiment-page">
      <%- include("../partials/aidesign/experiment-layout", { experiment }) %>

      <section class="aide-section aide-two-column reveal" aria-labelledby="purposeHeading">
        <div>
          <p class="eyebrow">Purpose</p>
          <h2 id="purposeHeading">A small financial UI with intentionally careful language.</h2>
        </div>
        <div class="aide-section-copy">
          <p><%= experiment.purpose %></p>
          <ul class="aide-check-list">
            <% experiment.requirements.forEach((requirement) => { %>
              <li><%= requirement %></li>
            <% }) %>
          </ul>
        </div>
      </section>

      <section class="aide-section reveal" aria-labelledby="testPromptHeading">
        <div class="section-head aide-section-head">
          <div>
            <p class="eyebrow">First Test Prompt</p>
            <h2 id="testPromptHeading">Original prompt shown to each platform</h2>
          </div>
        </div>
        <div class="aide-prompt-block">
          <p><%= experiment.prompt %></p>
        </div>
      </section>

      <section class="aide-section reveal" aria-labelledby="prototypeHeading">
        <div class="section-head aide-section-head">
          <div>
            <p class="eyebrow">Working Prototype</p>
            <h2 id="prototypeHeading">Stock performance projection test</h2>
          </div>
        </div>

        <div class="stock-prototype" data-stock-prototype>
          <div class="stock-prototype-intro">
            <div>
              <p class="aide-mini-label">Input</p>
              <h3>Analyze a ticker</h3>
              <p>
                This version uses structured demo data and a deterministic fallback when a symbol
                is not in the mock library. It is prepared so a real market data provider can be
                added later.
              </p>
            </div>
            <%- include("../partials/aidesign/stock-ticker-input") %>
          </div>

          <p class="stock-responsible-note">
            Financial markets are uncertain. This prototype uses estimated, modeled, and demo
            values for comparison purposes. It does not provide investment advice.
          </p>

          <p class="stock-form-message" data-stock-message aria-live="polite"></p>

          <div class="stock-results" data-stock-results hidden>
            <div class="stock-results-header">
              <div>
                <p class="aide-mini-label" data-stock-source>Demo data</p>
                <h3 data-stock-name>Stock name</h3>
              </div>
              <div class="stock-price-callout">
                <span>Current modeled price</span>
                <strong data-stock-current-price>$0.00</strong>
              </div>
            </div>

            <dl class="stock-metrics" aria-label="Stock performance metrics">
              <div>
                <dt>One-year starting price</dt>
                <dd data-stock-start-price>$0.00</dd>
              </div>
              <div>
                <dt>One-year ending price</dt>
                <dd data-stock-end-price>$0.00</dd>
              </div>
              <div>
                <dt>One-year percentage change</dt>
                <dd data-stock-percent-change>0.0%</dd>
              </div>
              <div>
                <dt>Highest price in period</dt>
                <dd data-stock-high-price>$0.00</dd>
              </div>
              <div>
                <dt>Lowest price in period</dt>
                <dd data-stock-low-price>$0.00</dd>
              </div>
              <div>
                <dt>Annualized volatility estimate</dt>
                <dd data-stock-volatility>0.0%</dd>
              </div>
            </dl>

            <div class="stock-analysis-grid">
              <%- include("../partials/aidesign/stock-performance-chart") %>
              <%- include("../partials/aidesign/projection-summary") %>
            </div>
          </div>

          <noscript>
            <p class="stock-responsible-note">
              JavaScript is required to run the interactive stock prototype.
            </p>
          </noscript>
        </div>
      </section>

      <section class="aide-section aide-two-column reveal" aria-labelledby="dataIntegrationHeading">
        <div>
          <p class="eyebrow">Data Status</p>
          <h2 id="dataIntegrationHeading">Demo data now, API-ready later.</h2>
        </div>
        <div class="aide-section-copy">
          <p>
            No live stock API key is configured in this environment, so the prototype clearly marks
            the output as demo data. The JavaScript keeps data access in a provider function so a
            service such as Alpha Vantage, Polygon.io, Twelve Data, Yahoo Finance-compatible data,
            or Financial Modeling Prep can replace the fallback without redesigning the interface.
          </p>
        </div>
      </section>

      <section class="aide-section reveal" aria-labelledby="comparisonHeading">
        <div class="section-head aide-section-head">
          <div>
            <p class="eyebrow">Evaluation Framework</p>
            <h2 id="comparisonHeading">AI Platform Comparison</h2>
          </div>
        </div>
        <div class="aide-comparison-grid">
          <% experiment.comparisonPlatforms.forEach((platform) => { %>
            <%- include("../partials/aidesign/ai-comparison-card", { platform }) %>
          <% }) %>
        </div>
      </section>

      <section class="aide-section aide-two-column reveal" aria-labelledby="reflectionHeading">
        <div>
          <p class="eyebrow">Human Reflection</p>
          <h2 id="reflectionHeading">Questions for critique</h2>
        </div>
        <div class="aide-section-copy">
          <p>
            This experiment is meant to reveal how an AI platform thinks through the product, not
            just how quickly it can produce a chart. The critique should stay grounded in usefulness,
            responsibility, and the quality of judgment shown by the generated application.
          </p>
          <ul class="aide-check-list">
            <% experiment.critiqueQuestions.forEach((question) => { %>
              <li><%= question %></li>
            <% }) %>
          </ul>
        </div>
      </section>
    </main>

    <%- include("../partials/public_footer") %>
    <%- include("../partials/consent_banner") %>

    <script src="/analytics.js"></script>
    <script src="/script.js"></script>
    <script src="/assets/aidesign.js"></script>
  </body>
</html>
