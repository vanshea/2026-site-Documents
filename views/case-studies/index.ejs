<!DOCTYPE html>
<html lang="en" data-theme="theme4">
  <head>
    <%- include("../partials/public_head", { pageTitle, metaDescription }) %>
  </head>
  <body>
    <div class="bg-shape bg-shape-a"></div>
    <div class="bg-shape bg-shape-b"></div>

    <%- include("../partials/public_header", { currentPath }) %>
    <%
      const indexContent = typeof caseStudyIndex !== "undefined" ? caseStudyIndex : {
        heroEyebrow: "Selected Work",
        heroTitle: "Case studies built from structured content, not duplicated templates.",
        heroLead: "Each entry below is powered by a reusable slug route and a JSON content file, so future case studies can be added in VS Code without rebuilding layout components.",
        topImage: null
      };
    %>

    <main id="top">
      <section class="hero case-study-index-hero reveal">
        <div class="case-study-index-copy">
          <p class="eyebrow"><%= indexContent.heroEyebrow %></p>
          <h1 id="caseStudiesIndexHeading"><%= indexContent.heroTitle %></h1>
          <p class="lead"><%= indexContent.heroLead %></p>
        </div>
      </section>

      <section class="case-study-block reveal" aria-labelledby="caseStudiesIndexHeading">
        <div class="grid case-study-card-grid">
          <% caseStudies.forEach((caseStudy) => { %>
            <%- include("../partials/case-studies/case-study-card", { caseStudy }) %>
          <% }) %>
        </div>
      </section>
    </main>

    <%- include("../partials/public_footer") %>
    <%- include("../partials/consent_banner") %>

    <script src="/analytics.js"></script>
    <script src="/script.js?v=20260706-clear-logo-1"></script>
  </body>
</html>
