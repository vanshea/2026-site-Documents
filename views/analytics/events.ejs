<%- include('../partials/dashboard_head', { title: 'Events' }) %>
<%- include('../partials/dashboard_nav', { activeTab, range, rangeQuery, exportReport, currentPath }) %>

<main class="space-y-4">
  <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-4">
    <h2 class="text-base font-semibold">Event Counts</h2>
    <div class="mt-2 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left text-slate-400">
          <tr>
            <th class="py-1 pr-4">Event</th>
            <th class="py-1 pr-4">Count</th>
            <th class="py-1">Unique Users (approx)</th>
          </tr>
        </thead>
        <tbody>
          <% if (!eventsReport.counts.length) { %>
            <tr><td class="py-2 text-slate-500" colspan="3">No events in selected range.</td></tr>
          <% } %>
          <% eventsReport.counts.forEach((row) => { %>
            <tr class="border-t border-slate-800">
              <td class="py-2 pr-4 font-mono text-xs"><%= row.eventName %></td>
              <td class="py-2 pr-4"><%= row.count %></td>
              <td class="py-2"><%= row.uniqueUsers %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-4">
    <h2 class="text-base font-semibold">Trend by Date</h2>
    <% const maxCount = eventsReport.trend.reduce((max, row) => Math.max(max, row.count), 0) || 1; %>
    <div class="mt-3 space-y-2">
      <% if (!eventsReport.trend.length) { %>
        <p class="text-sm text-slate-500">No trend data in selected range.</p>
      <% } %>
      <% eventsReport.trend.forEach((row) => { %>
        <div>
          <div class="mb-1 flex items-center justify-between text-xs text-slate-400">
            <span><%= row.date %></span>
            <span><%= row.count %></span>
          </div>
          <div class="h-2 rounded-full bg-slate-800">
            <div
              class="h-2 rounded-full bg-cyan-400"
              style="width: <%= Math.max(3, Math.round((row.count / maxCount) * 100)) %>%"
            ></div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
</main>

<%- include('../partials/dashboard_footer') %>
