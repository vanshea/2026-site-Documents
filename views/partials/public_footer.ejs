<footer class="site-footer" id="siteFooter" data-footer-pattern>
  <div class="footer-pattern-layer" aria-hidden="true"></div>
  <div
    class="site-footer-art"
    data-footer-art-trigger
    role="button"
    tabindex="0"
    aria-label="Activate footer artwork animation"
  >
    <img
      src="/assets/footer-art/site-footer-rev-sm.png"
      alt="Artwork that is evolving, made by hand, summarizing past work. No A.I. was used or harmed in this creation."
      width="1800"
      height="1973"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="site-footer-inner">
    <div class="site-footer-controls">
      <div class="footer-actions" aria-label="Connect with Van Shea">
        <script
          src="https://assets.calendly.com/assets/external/widget.js"
          type="text/javascript"
          async
        ></script>
        <a
          class="theme-link"
          href="https://calendly.com/van-shea/30min"
          target="_blank"
          rel="noreferrer"
          onclick="if (window.Calendly) { Calendly.initPopupWidget({url: 'https://calendly.com/van-shea/30min'}); return false; }"
        >
          Schedule Time
        </a>
        <a
          class="theme-link"
          href="https://www.linkedin.com/in/vanshea/"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn
        </a>
      </div>
      <div class="theme-switcher" role="group" aria-label="Choose site theme">
        <button
          class="theme-link"
          type="button"
          data-theme="theme1"
          aria-pressed="false"
        >
          Basic Theme
        </button>
        <button
          class="theme-link"
          type="button"
          data-theme="theme2"
          aria-pressed="false"
        >
          Pro Theme
        </button>
        <button
          class="theme-link"
          type="button"
          data-theme="theme3"
          aria-pressed="false"
        >
          High Contrast
        </button>
        <button
          class="theme-link is-active"
          type="button"
          data-theme="theme4"
          aria-pressed="true"
        >
          Wild Theme
        </button>
      </div>
    </div>
    <p>&copy; <span id="year"></span> Van Shea Sedita. All rights reserved.</p>
    <button class="footer-privacy-link" id="consentManageBtn" type="button">
      Privacy Policy
    </button>
    <p class="footer-animation-meta" id="footerAnimationMeta" data-footer-floating-meta>
      Animation generated 1 time · 2026-05-21 16:39:39 EDT
    </p>
  </div>
</footer>
