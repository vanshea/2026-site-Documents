<header class="site-header">
  <a href="/" class="brand" aria-label="Back to homepage">
    <picture>
      <img
        id="brandLogoLightImage"
        class="brand-logo"
        src="/assets/new-logo-mark.svg"
        data-logo-light="/assets/new-logo-mark.svg"
        data-logo-dark="/assets/new-logo-mark-lite.svg"
        alt="Van Shea Creative"
        width="56"
        height="56"
      />
    </picture>
    <span class="brand-name">Van Shea Creative</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="siteNav"
    aria-label="Open navigation menu"
  >
    <span class="sr-only">Toggle navigation</span>
    <span class="nav-toggle-icon" aria-hidden="true">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </span>
  </button>
  <nav id="siteNav" class="nav">
    <a href="/#work" <%- currentPath === "/" ? 'aria-current="page"' : "" %>>Work</a>
    <a href="/case-studies"<%- currentPath.startsWith("/case-studies") ? ' aria-current="page"' : "" %>>
      Case Studies
    </a>
    <a href="/aidesign"<%- currentPath.startsWith("/aidesign") ? ' aria-current="page"' : "" %>>
      AIdesign
    </a>
    <a href="/blog/"<%- currentPath.startsWith("/blog") ? ' aria-current="page"' : "" %>>
      Blog
    </a>
  </nav>
</header>
