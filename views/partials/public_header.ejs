<header class="site-header">
  <a href="/" class="brand" aria-label="Back to homepage">
    <picture>
      <img
        id="brandLogoLightImage"
        class="brand-logo"
        src="/assets/new-logo-mark.svg"
        data-logo-light="/assets/new-logo-mark.svg"
        data-logo-dark="/assets/new-logo-mark-lite.svg"
        alt="Van Shea Creative"
        width="56"
        height="56"
