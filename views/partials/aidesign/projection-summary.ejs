<section class="projection-panel" aria-labelledby="projectionHeading">
  <div class="stock-panel-head">
    <div>
      <p class="aide-mini-label">Three-Month Projection</p>
      <h3 id="projectionHeading">Modeled scenario</h3>
    </div>
  </div>
  <p class="projection-caution">
    This projection is a simplified model based on historical price movement. It is not financial
    advice and should not be used as the sole basis for investment decisions.
  </p>
  <dl class="projection-summary" data-projection-summary>
    <div>
      <dt>Projected price range</dt>
      <dd data-projection-range>Run an analysis to view range.</dd>
    </div>
    <div>
      <dt>Projected percentage change</dt>
      <dd data-projection-change>Run an analysis to view change.</dd>
    </div>
    <div>
      <dt>Confidence note</dt>
      <dd data-projection-confidence>Projection confidence is intentionally conservative.</dd>
    </div>
  </dl>
  <div class="projection-assumptions">
    <p class="aide-mini-label">Assumptions used</p>
    <ul data-projection-assumptions>
      <li>Historical demo prices are used until a real market data API is connected.</li>
    </ul>
  </div>
</section>
