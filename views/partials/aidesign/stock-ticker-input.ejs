<form class="stock-input-form" id="stockAnalyzerForm" data-stock-form>
  <label for="stockTickerInput">
    <span>Ticker symbol</span>
    <input
      id="stockTickerInput"
      name="ticker"
      type="text"
      inputmode="latin"
      autocomplete="off"
      spellcheck="false"
      maxlength="10"
      placeholder="Enter a ticker symbol, e.g. AAPL"
      value="AAPL"
    />
  </label>
  <button class="btn" type="submit">Analyze Stock</button>
</form>
