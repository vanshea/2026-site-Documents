<aside
  class="consent-banner"
  id="consentBanner"
  role="dialog"
  aria-live="polite"
  aria-label="Analytics consent"
  hidden
>
  <p class="consent-text">
    We use privacy-first analytics to measure meaningful actions, not personal identity.
  </p>
  <div class="consent-actions">
    <button class="theme-link consent-btn" id="consentDenyBtn" type="button">
      Deny
    </button>
    <button class="btn consent-btn consent-allow" id="consentAllowBtn" type="button">
      Allow Analytics
    </button>
  </div>
</aside>
