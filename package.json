{
  "name": "design-portfolio-site",
  "version": "1.0.0",
  "description": "Simple design portfolio with contact email API.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n express,analytics \"node server.js\" \"npm --prefix analytics-ui run dev\"",
    "analytics:dev": "npm --prefix analytics-ui run dev",
    "analytics:build": "npm --prefix analytics-ui run build",
    "analytics:start": "npm --prefix analytics-ui run start",
    "client:scaffold": "node scripts/create-client-scaffold.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_analytics",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "launch:bundle": "node scripts/create-launch-ready-bundle.mjs",
    "siteground:bundle": "node scripts/create-siteground-static-bundle.mjs",
    "backup:dynamic": "node scripts/create-dynamic-backup.mjs",
    "backup:dynamic-and-static": "node scripts/create-dynamic-and-static-packages.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "ejs": "^4.0.1",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "http-proxy-middleware": "^3.0.5",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "prisma": "^6.16.2",
    "sharp": "^0.33.5"
  }
}
