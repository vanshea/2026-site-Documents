PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_analytics?schema=public
SESSION_SECRET=replace_with_long_random_secret
TRUSTED_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://example.com,https://www.example.com
ANALYTICS_ADMIN_USERNAME=admin
ANALYTICS_ADMIN_PASSWORD=change_me_now
ANALYTICS_HOME_ADMIN_PASSWORD=change_me_before_launch
ANALYTICS_VIEWER_USERNAME=viewer
ANALYTICS_VIEWER_PASSWORD=change_me_too
ANALYTICS_SESSION_TTL_MINUTES=60
ANALYTICS_COLLECT_ENABLED=true
ANALYTICS_DASHBOARD_ENABLED=true
ANALYTICS_UI_ENABLED=true
ANALYTICS_UI_ORIGIN=http://127.0.0.1:3001
CLIENT_ACCESS_COOKIE_SECRET=replace_with_long_random_cookie_secret
ADMIN_SESSION_COOKIE_SECRET=replace_with_separate_admin_cookie_secret
CLIENT_PASSWORD_PEPPER=optional_server_side_password_pepper
CLIENT_SECRETS_DB_PATH=/var/lib/portfolio-site/client-secrets.sqlite
ANALYTICS_CRON=5 0 * * *
ANALYTICS_CRON_TZ=UTC
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
ANALYTICS_ENABLED=true
ANALYTICS_EXCLUDE_INTERNAL=false
ANALYTICS_DEBUG=false
